{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "taite-board architecture and tenant boundaries",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "boundaries", "tenants", "pipelines"],
  "properties": {
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "layer", "path", "dependsOn"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "layer": {"enum": ["edge", "app", "pipeline", "storage"]},
          "path": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "boundaries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "level", "details", "path"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "level": {"enum": ["shared", "host_routed", "path_isolated", "prefix_isolated"]},
          "details": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "tenants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "hosts", "dataUrl", "fallbackDataUrl", "storagePrefix"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dataUrl": {"type": "string", "minLength": 1},
          "fallbackDataUrl": {"type": "string", "minLength": 1},
          "storagePrefix": {"type": "string", "minLength": 1}
        }
      }
    },
    "pipelines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "mode", "description", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "mode": {"enum": ["pull", "manual", "cron", "reconcile"]},
          "description": {"type": "string", "minLength": 1},
          "steps": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "label", "component", "entryPath", "summary", "guards"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "label": {"type": "string", "minLength": 1},
                "component": {"type": "string", "minLength": 1},
                "entryPath": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1},
                "guards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "stores": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
