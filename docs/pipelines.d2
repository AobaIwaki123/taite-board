x_scrape_intake: "X タイムライン巡回 & 承認パイプライン [PULL]" {
  direction: right
  style.fill: "#1c1917"
  style.stroke: "#fb7185"
  style.border-radius: 12
  fetch_source: "1. ソース取得 (URL / Fixture / X API)\n[scrape] internal/scrape/source.go\nGuard: Dry-Run (\$0) 優先\nGuard: URLList / Fixture / XAPI 切替" {
    style.border-radius: 8
    style.fill: "#292524"
    style.stroke: "#fb7185"
    style.font-color: "#fafaf9"
  }
  dedupe_filter: "2. SinceID / 重複・経過時間フィルタ\n[scrape] internal/scrape/runner.go\nGuard: SinceID 単調増加\nGuard: MaxAge 上限\nGuard: ProcessedIDs 排除\nStore: scrape/state/<group>.json" {
    style.border-radius: 8
    style.fill: "#292524"
    style.stroke: "#fb7185"
    style.font-color: "#fafaf9"
  }
  stage_pending: "3. PendingQueue ステージング\n[monitor] internal/monitor/server.go\nGuard: 即公開禁止 (Staging)\nGuard: Ambiguous Session 検知\nStore: monitor PendingQueue" {
    style.border-radius: 8
    style.fill: "#292524"
    style.stroke: "#fb7185"
    style.font-color: "#fafaf9"
  }
  admin_promote: "4. /admin 1タップ昇格\n[web] apps/web/src/components/AdminView.tsx\nGuard: RBAC 管理者認可\nGuard: Promote 後に自動消込\nStore: data/groups/<id>/schedule.json" {
    style.border-radius: 8
    style.fill: "#292524"
    style.stroke: "#fb7185"
    style.font-color: "#fafaf9"
  }
  fetch_source -> dedupe_filter
  dedupe_filter -> stage_pending
  stage_pending -> admin_promote
}

